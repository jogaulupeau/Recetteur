    {
      "titre": "Spaghetti bolognaise",
      "description": "La sauce mijotée du dimanche, qui se congèle très bien.",
      "type": "plat",
      "portions": 4,
      "portions_unite": "personnes",
      "temps_preparation": 20,
      "temps_cuisson": 60,
      "difficulte": "facile",
      "cuisine": "italienne",
      "tags": ["pâtes", "boeuf", "familial", "congélation"],
      "ingredients": [
        { "id": "huile", "nom": "huile d’olive", "quantite": 2, "unite": "c. à soupe", "rayon": "epicerie", "basique": true },
        { "id": "oignon", "nom": "oignon", "nom_pluriel": "oignons", "quantite": 1, "rayon": "fruits-legumes", "note": "émincé" },
        { "id": "ail", "nom": "ail", "quantite": 2, "unite": "gousse", "rayon": "fruits-legumes", "note": "écrasées" },
        { "id": "carotte", "nom": "carotte", "quantite": 1, "rayon": "fruits-legumes", "note": "en petits dés" },
        { "id": "boeuf", "nom": "viande de bœuf hachée", "quantite": 400, "unite": "g", "rayon": "viandes-poissons" },
        { "id": "tomates", "nom": "tomates concassées en boîte", "quantite": 400, "unite": "g", "rayon": "epicerie" },
        { "id": "concentre", "nom": "concentré de tomate", "quantite": 2, "unite": "c. à soupe", "rayon": "epicerie" },
        { "id": "vin", "nom": "vin rouge", "quantite": 10, "unite": "cl", "rayon": "boissons", "optionnel": true },
        { "id": "origan", "nom": "origan séché", "quantite": 1, "unite": "c. à café", "rayon": "condiments-epices", "fixe": true },
        { "id": "spaghetti", "nom": "spaghetti", "quantite": 320, "unite": "g", "rayon": "epicerie" },
        { "id": "parmesan", "nom": "parmesan râpé", "quantite": 40, "unite": "g", "rayon": "cremerie" },
        { "id": "sel", "nom": "sel", "quantite": null, "basique": true },
        { "id": "poivre", "nom": "poivre", "quantite": null, "basique": true }
      ],
      "etapes": [
        { "titre": "Le fond de sauce", "texte": "Faites chauffer {{huile}} d’huile dans une sauteuse. Faites revenir l’oignon, l’ail et la carotte 5 minutes à feu moyen, en remuant.", "duree": 5, "ingredients": ["huile", "oignon", "ail", "carotte"] },
        { "titre": "La viande", "texte": "Ajoutez {{boeuf}} de viande hachée et faites-la dorer en l’émiettant, 5 minutes. Salez, poivrez.", "duree": 5, "ingredients": ["boeuf", "sel", "poivre"] },
        { "titre": "Le mijotage", "texte": "Versez le vin, laissez réduire 2 minutes, puis ajoutez les tomates, le concentré ({{concentre}}) et l’origan. Couvrez et laissez mijoter 45 minutes à feu doux.", "duree": 45, "ingredients": ["vin", "tomates", "concentre", "origan"] },
        { "titre": "Les pâtes", "texte": "Faites cuire {{spaghetti}} de spaghetti dans une grande casserole d’eau bouillante salée, selon le temps indiqué sur le paquet. Égouttez.", "duree": 10, "ingredients": ["spaghetti"] },
        { "titre": "Service", "texte": "Servez les pâtes nappées de sauce et saupoudrées de parmesan ({{parmesan}}).", "ingredients": ["parmesan"] }
      ],
      "conservation": "3 jours au réfrigérateur, 3 mois au congélateur (la sauce seule).",
      "notes": "Doubler la sauce et congeler la moitié."
    },
    {
      "titre": "Poulet rôti aux pommes de terre",
      "type": "plat",
      "portions": 4,
      "temps_preparation": 15,
      "temps_cuisson": 75,
      "difficulte": "facile",
      "cuisine": "française",
      "tags": ["poulet", "four", "familial", "dimanche"],
      "ingredients": [
        { "id": "poulet", "nom": "poulet fermier", "quantite": 1, "unite": "", "note": "d’environ 1,6 kg", "rayon": "viandes-poissons", "fixe": true },
        { "id": "patates", "nom": "pommes de terre", "quantite": 800, "unite": "g", "rayon": "fruits-legumes", "note": "à chair ferme" },
        { "id": "citron", "nom": "citron", "quantite": 1, "rayon": "fruits-legumes" },
        { "id": "ail", "nom": "ail", "quantite": 4, "unite": "gousse", "rayon": "fruits-legumes", "note": "en chemise" },
        { "id": "thym", "nom": "thym", "quantite": 4, "unite": "brin", "rayon": "fruits-legumes" },
        { "id": "beurre", "nom": "beurre", "quantite": 30, "unite": "g", "rayon": "cremerie" },
        { "id": "huile", "nom": "huile d’olive", "quantite": 2, "unite": "c. à soupe", "rayon": "epicerie", "basique": true },
        { "id": "sel", "nom": "sel", "quantite": null, "basique": true },
        { "id": "poivre", "nom": "poivre", "quantite": null, "basique": true }
      ],
      "etapes": [
        { "titre": "Préparer", "texte": "Préchauffez le four à 200 °C. Sortez le poulet du réfrigérateur 30 minutes avant. Glissez dans la cavité le citron coupé en deux, {{thym}} de thym et 2 gousses d’ail.", "ingredients": ["poulet", "citron", "thym", "ail"] },
        { "texte": "Badigeonnez le poulet avec {{beurre}} de beurre mou. Salez et poivrez généreusement.", "ingredients": ["beurre", "sel", "poivre"] },
        { "texte": "Épluchez les pommes de terre ({{patates}}), coupez-les en quartiers et mélangez-les avec {{huile}} d’huile d’olive et le reste de l’ail dans un grand plat. Posez le poulet dessus.", "ingredients": ["patates", "huile", "ail"] },
        { "titre": "Cuisson", "texte": "Enfournez 1 h 15, en arrosant avec le jus de cuisson toutes les 20 minutes. Laissez reposer 10 minutes sous du papier d’aluminium avant de découper.", "duree": 75 }
      ],
      "notes": "Le temps de cuisson dépend du poids : comptez environ 45 minutes par kilo, plus 15 minutes."
    },
    {
      "titre": "Salade de lentilles, feta et noix",
      "type": "plat",
      "portions": 4,
      "temps_preparation": 15,
      "temps_cuisson": 25,
      "difficulte": "facile",
      "tags": ["végétarien", "rapide", "salade", "été"],
      "ingredients": [
        { "id": "lentilles", "nom": "lentilles vertes", "quantite": 250, "unite": "g", "rayon": "epicerie" },
        { "id": "feta", "nom": "feta", "quantite": 200, "unite": "g", "rayon": "cremerie" },
        { "id": "noix", "nom": "noix", "quantite": 60, "unite": "g", "rayon": "epicerie" },
        { "id": "oignon", "nom": "oignon rouge", "quantite": 1, "rayon": "fruits-legumes" },
        { "id": "tomates", "nom": "tomates cerises", "quantite": 250, "unite": "g", "rayon": "fruits-legumes" },
        { "id": "persil", "nom": "persil", "quantite": 1, "unite": "botte", "rayon": "fruits-legumes" },
        { "id": "huile", "nom": "huile d’olive", "quantite": 4, "unite": "c. à soupe", "rayon": "epicerie", "basique": true, "groupe": "Vinaigrette" },
        { "id": "vinaigre", "nom": "vinaigre balsamique", "quantite": 2, "unite": "c. à soupe", "rayon": "condiments-epices", "groupe": "Vinaigrette" },
        { "id": "moutarde", "nom": "moutarde", "quantite": 1, "unite": "c. à café", "rayon": "condiments-epices", "groupe": "Vinaigrette" }
      ],
      "etapes": [
        { "texte": "Rincez {{lentilles}} de lentilles et faites-les cuire 20 à 25 minutes dans de l’eau frémissante non salée. Égouttez et laissez tiédir.", "duree": 25, "ingredients": ["lentilles"] },
        { "texte": "Émincez l’oignon, coupez les tomates en deux, ciselez le persil, concassez les noix et émiettez la feta.", "ingredients": ["oignon", "tomates", "persil", "noix", "feta"] },
        { "texte": "Mélangez {{huile}} d’huile d’olive, {{vinaigre}} de vinaigre balsamique et {{moutarde}} de moutarde.", "ingredients": ["huile", "vinaigre", "moutarde"] },
        { "texte": "Mélangez tous les ingrédients avec la vinaigrette. Servez tiède ou frais." }
      ]
    },
    {
